%% sys.config — runtime configuration for rate_demo.
%%
%% Pass to the VM with:  erl -config config/sys
%%
%% ── Invariant recap ────────────────────────────────────────────────
%%   ratio * producer_rate =< consumer_rate   =>  STABLE
%%   ratio * producer_rate  > consumer_rate   =>  OVERLOADED
%%
%% ── Scenario A: stable (default) ───────────────────────────────────
%%   2 * 3 = 6 =< 10   queue stays near 0
%%
%% ── Scenario B: edge (saturated) ───────────────────────────────────
%%   2 * 5 = 10 =< 10  queue stays bounded but tight
%%   {producer_rate, 5}, {consumer_rate, 10}, {ratio, 2}
%%
%% ── Scenario C: violated ───────────────────────────────────────────
%%   4 * 3 = 12 > 10   queue grows without bound
%%   {producer_rate, 3}, {consumer_rate, 10}, {ratio, 4}
%%
%% ── Scenario D: heavily overloaded ─────────────────────────────────
%%   3 * 10 = 30 > 10  rapid divergence
%%   {producer_rate, 10}, {consumer_rate, 10}, {ratio, 3}
%% ───────────────────────────────────────────────────────────────────

[
  {rate_demo, [
      {producer_rate, 1},
      {consumer_rate, 1},
      {ratio,         1},
      {tick,       1000},
      {samples,       5},
      {slope,       0.5}
  ]}
].
