    do
      call (remote 'erlang':'spawn'/1)(_1) >> <C>
    then
    do
      call (remote 'erlang':'!'/2)(C, {go,1}) >> <>
    then
    letrec_goto recv$^1()
      do
	bif (internal 'recv_peek_message'/0)() >> <_7,_5>
      then
      match
	select _7
	  type k_atom
